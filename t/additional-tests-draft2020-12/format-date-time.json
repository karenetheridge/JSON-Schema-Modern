[
    {
        "description": "leap seconds",
        "schema": {
            "format": "date-time"
        },
        "tests": [
            {
                "description": "a valid date-time with a leap second, UTC",
                "data": "1998-12-31T23:59:60Z",
                "valid": true
            },
            {
                "description": "a valid date-time with a leap second, with minus offset",
                "data": "1998-12-31T15:59:60.123-08:00",
                "valid": true
            },
            {
                "description": "an invalid date-time with a leap second, UTC",
                "data": "1998-12-30T23:59:60Z",
                "valid": false
            },
            {
                "description": "an invalid date-time with a leap second, with minus offset",
                "data": "1998-12-30T15:59:60.123-08:00",
                "valid": false
            },
            {
                "description": "a valid date-time with a leap second, with negative half-hour offset",
                "data": "1998-12-31T22:29:60.123-01:30",
                "valid": true
            },
            {
                "description": "a valid date-time with a leap second, with positive half-hour offset",
                "data": "1999-01-01T01:29:60.123+01:30",
                "valid": true
            },
            {
                "description": "2021 is not a leap year",
                "data": "2021-02-29T12:00:00Z",
                "valid": false
            },
            {
                "description": "2020 is a leap year",
                "data": "2020-02-29T12:00:00Z",
                "valid": true
            },
            {
                "description": "2000 is a leap year",
                "data": "2000-02-29T12:00:00Z",
                "valid": true
            },
            {
                "description": "1900 is not a leap year",
                "data": "1900-02-29T12:00:00Z",
                "valid": false
            },
            {
                "description": "century year 0400 is a leap year",
                "comment": "https://www.rfc-editor.org/rfc/rfc3339#appendix-C — 400-year cycle boundary",
                "data": "0400-02-29T12:00:00Z",
                "valid": true
            },
            {
                "description": "century year 2100 is not a leap year",
                "comment": "https://www.rfc-editor.org/rfc/rfc3339#appendix-C — future century year",
                "data": "2100-02-29T12:00:00Z",
                "valid": false
            }
        ]
    }
]
